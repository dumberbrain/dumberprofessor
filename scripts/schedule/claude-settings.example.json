{
  "permissions": {
    "allow": [
      "Bash(npm run fp *)",
      "Bash(npm run -s fp *)",
      "WebFetch",
      "Write(data/runs/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "npm run -s fp -- unread --hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
