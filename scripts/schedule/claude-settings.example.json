{
  "permissions": {
    "allow": ["Bash(npm run fp *)", "Bash(npm run -s fp *)", "WebFetch", "Write(data/runs/**)", "Write(data/drafts/**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "npm run -s fp -- session-start --hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
