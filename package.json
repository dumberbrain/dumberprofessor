{
  "name": "professor",
  "version": "0.1.0",
  "private": true,
  "description": "Personal multi-domain researcher and mentor: lessons, reviews, verified daily news",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "fp": "tsx src/cli/index.ts",
    "reader": "npm run dev -w apps/reader",
    "reader:build": "npm run build -w apps/reader",
    "reader:start": "npm run start -w apps/reader",
    "test": "vitest run && npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "prepare": "husky || true",
    "check": "sh .husky/pre-push",
    "check:staged": "sh .husky/pre-commit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
