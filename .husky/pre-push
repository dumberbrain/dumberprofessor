# Runs the CI sweep BEFORE the push: whole-repo format, lint, types, tests.
# The test suite runs offline in ~10s, so it fits here (cost rule: under ~60s);
# installs and builds are deliberately absent. This is the sweep a staged view
# cannot do: a config edit that breaks an untouched file. CI
# (.github/workflows/ci.yml) runs the same checks and remains the authority.
#
# A step's output is shown only when it fails.
#
# Bypass: `HUSKY=0 git push` or `git push --no-verify`. By hand: `npm run check`.

set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

. "$ROOT/.husky/lib.sh"

# The step count is CONSTANT. A skipped step (no node_modules) still consumes
# its number rather than shrinking the denominator, so "how many are left" means
# the same thing on every machine.
TOTAL=5
T_ALL="$(now_ms)"

printf '\n  pre-push · %s checks (~20s)\n\n' "$TOTAL"

step "prettier --check"
if [ -d node_modules ]; then
  OUT="$(npm run --silent format:check 2>&1)" || { printf '\n%s' "$OUT" >&2; fail "formatting differs from prettier (fix: npm run format)"; }
  step_ok
else
  step_skip "no node_modules, CI still checks this"
fi

step "oxlint"
if [ -d node_modules ]; then
  npm run --silent lint || fail "lint failed"
  step_ok
else
  step_skip "no node_modules, CI still checks this"
fi

step "typecheck"
if [ -d node_modules ]; then
  npm run --silent typecheck || fail "typecheck failed"
  step_ok
else
  step_skip "no node_modules, CI still checks this"
fi

step "test"
if [ -d node_modules ]; then
  OUT="$(npm run --silent test 2>&1)" || { printf '\n%s' "$OUT" >&2; fail "tests failed"; }
  step_ok
else
  step_skip "no node_modules, CI still checks this"
fi

step "package.json version"
node -e 'const v=require("./package.json").version; if(!/^[0-9]+[.][0-9]+[.][0-9]+([-][0-9A-Za-z.-]+)?([+][0-9A-Za-z.-]+)?$/.test(v)){console.error("package.json#version is not semver:",JSON.stringify(v));process.exit(1)}' || fail "package.json version is not usable"
step_ok

printf '\n✓ pre-push checks passed%s\n' "$(since "$T_ALL")"
