{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "language": {
      "default": {
        "output": "az",
        "keepTermsInEnglish": true
      },
      "type": "object",
      "properties": {
        "output": {
          "default": "az",
          "description": "Answer language, e.g. az, en",
          "type": "string",
          "minLength": 2
        },
        "keepTermsInEnglish": {
          "default": true,
          "description": "Keep technical terms and titles in English",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "focus": {
      "default": [],
      "description": "Ordered domain ids to prioritize (earlier weighs more). Empty: all domains equal. Also: fp focus set|clear",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "domains": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "kebab-case identifier, referenced by focus and sources"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What this domain covers"
          },
          "kind": {
            "default": "technical",
            "type": "string",
            "enum": [
              "technical",
              "language",
              "general"
            ],
            "description": "technical: software/engineering · language: e.g. English · general: any other field"
          },
          "depth": {
            "default": "intermediate",
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced",
              "expert"
            ],
            "description": "How deep lessons and explanations go"
          },
          "level": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "B1",
              "B2",
              "C1",
              "C2"
            ],
            "description": "Language domains: your CEFR level"
          },
          "priorityTopics": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "curriculum": {
            "default": [],
            "description": "Ordered lesson topics. Empty: the Professor proposes topics from sources",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "additionalProperties": false,
        "description": "A field you want to learn — any field"
      }
    },
    "sources": {
      "default": [],
      "description": "Where to learn from and collect news from",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "rss",
              "web",
              "hn",
              "github-advisories",
              "youtube-channel",
              "docs",
              "github",
              "youtube-video",
              "youtube-playlist"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "tier": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              },
              {
                "type": "number",
                "const": 4
              }
            ],
            "description": "1 primary/official · 2 technical analysis · 3 community · 4 learning resource"
          },
          "domains": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "use": {
            "default": [
              "lessons"
            ],
            "description": "news: collected for the daily report · lessons: used to teach and answer",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "news",
                "lessons"
              ]
            }
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "channelId": {
            "description": "youtube-channel: filled by `fp sources resolve`",
            "type": [
              "string",
              "null"
            ]
          },
          "params": {
            "description": "Collector options (e.g. minPoints, ecosystem)",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "purpose": {
            "default": "unspecified",
            "description": "Why this source is configured",
            "type": "string",
            "minLength": 1
          },
          "updateFrequency": {
            "default": "unspecified",
            "description": "How often it publishes",
            "type": "string",
            "minLength": 1
          },
          "reliability": {
            "default": "unspecified",
            "description": "How far it can be trusted",
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "default": "unspecified",
            "description": "Known limitations",
            "type": "string",
            "minLength": 1
          },
          "failureBehavior": {
            "default": "unspecified",
            "description": "What happens when it is unavailable",
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "url",
          "tier",
          "domains"
        ],
        "additionalProperties": false
      }
    },
    "ranking": {
      "default": {
        "priorityTechnologies": [],
        "ignoredTopics": []
      },
      "type": "object",
      "properties": {
        "priorityTechnologies": {
          "default": [],
          "description": "News ranking: earlier entries weigh more",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ignoredTopics": {
          "default": [],
          "description": "News matching only these topics is dropped (security advisories are always kept)",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "extraSources": {
      "default": {
        "allowed": "ask",
        "maxFetchesPerAnswer": 3
      },
      "type": "object",
      "properties": {
        "allowed": {
          "default": "ask",
          "description": "May the Professor search beyond your sources?",
          "type": "string",
          "enum": [
            "never",
            "ask",
            "always"
          ]
        },
        "maxFetchesPerAnswer": {
          "default": 3,
          "description": "Upper bound on pages read per answer (token budget)",
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "additionalProperties": false
    },
    "sessionStart": {
      "default": {
        "mode": "ask",
        "actions": []
      },
      "description": "What happens when a Claude Code session starts",
      "type": "object",
      "properties": {
        "mode": {
          "default": "ask",
          "description": "ask: ask what you want · actions: run enabled actions in order · off: nothing",
          "type": "string",
          "enum": [
            "ask",
            "actions",
            "off"
          ]
        },
        "actions": {
          "default": [],
          "description": "In ask mode: the menu. In actions mode: run in this order",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "news",
                  "lesson",
                  "review",
                  "english"
                ]
              },
              "enabled": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "lesson": {
      "default": {
        "quizQuestions": 3,
        "questionTypes": [
          "conceptual",
          "code-reading"
        ],
        "revealAnswersAfterAttempt": true,
        "style": "concise"
      },
      "type": "object",
      "properties": {
        "quizQuestions": {
          "default": 3,
          "description": "Questions at the end of each lesson",
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "questionTypes": {
          "default": [
            "conceptual",
            "code-reading"
          ],
          "description": "Types that do not fit a domain kind are skipped for it",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "conceptual",
              "code-reading",
              "debugging",
              "implementation",
              "comparison",
              "vocabulary",
              "grammar",
              "translation",
              "writing"
            ]
          }
        },
        "revealAnswersAfterAttempt": {
          "default": true,
          "type": "boolean"
        },
        "style": {
          "default": "concise",
          "description": "concise uses fewer tokens",
          "type": "string",
          "enum": [
            "concise",
            "detailed"
          ]
        }
      },
      "additionalProperties": false
    },
    "documents": {
      "default": {
        "autoSave": true,
        "dir": "documents"
      },
      "description": "Your library of lessons, research and news (Markdown)",
      "type": "object",
      "properties": {
        "autoSave": {
          "default": true,
          "description": "Save every lesson, research answer and daily report as Markdown",
          "type": "boolean"
        },
        "dir": {
          "default": "documents",
          "description": "Folder for the Markdown documents, relative to the project",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "schedule": {
      "default": {
        "enabled": false,
        "generationTime": "08:00"
      },
      "description": "Daily news report schedule",
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Set only by `fp schedule enable|disable`",
          "type": "boolean"
        },
        "generationTime": {
          "default": "08:00",
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "timeZone": {
          "description": "IANA zone, e.g. Asia/Baku; default: system zone",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "domains"
  ],
  "additionalProperties": false,
  "description": "Professor configuration — edited by hand. Validate with: npm run fp -- config check",
  "title": "Professor configuration"
}
